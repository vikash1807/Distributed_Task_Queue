# Task-queue (Python/FastAPI) configuration. All values shown are the defaults.
# Python reads real environment variables, not this file automatically.
# Compose reads .env for interpolation and explicitly passes supported settings.
# For native runs, export settings or use: uv run --env-file .env python -m app.main

# --- Docker Compose only ---
DOCKER_API_PORT=8080        # host port, bound to 127.0.0.1; internal API port stays 8080
DOCKER_STOP_GRACE_PERIOD=30s # increase when handler/polling timeouts need more drain time
# Compose fixes REDIS_ADDR=redis:6379, REDIS_PASSWORD="", and SERVER_PORT=8080.
# Redis has no published host port and uses a persistent named volume.

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- HTTP ---
SERVER_PORT=8080            # server API port
METRICS_PORT=9100           # reserved setting; no standalone worker listener currently

# --- Workers / execution ---
WORKER_COUNT=5              # executor tasks per node
POLL_INTERVAL_MS=500        # back-off after a dequeue error (empty-queue wait is the doorbell)
DRAIN_TIMEOUT_MS=5000       # per-task handler timeout; bounds in-flight shutdown drain
# RUN_WORKERS=true            # run the in-process worker pool (single-binary/dev)

# --- Doorbell (P3.4 blocking pickup) ---
SIGNAL_BLOCK_MS=1000        # BLPOP block / shutdown-check / fallback-poll interval
SIGNAL_CAP=1024             # max wake-up tokens retained in the doorbell list

# --- Leases / reaper ---
VISIBILITY_TIMEOUT_MS=30000 # lease duration before the reaper reclaims
REAPER_INTERVAL_MS=5000      # reaper scan cadence

# --- Cluster membership ---
HEARTBEAT_INTERVAL_MS=3000  # node heartbeat refresh
HEARTBEAT_TTL_MS=10000      # heartbeat key expiry (must exceed the interval)
DEAD_NODE_GRACE_MS=30000    # dead-node card visibility before prune

# # --- Backpressure (P3.6) ---
# MAX_QUEUE_DEPTH=0           # ready-depth at/above which submits get 429; 0 = disabled
# RETRY_AFTER_SECONDS=5       # Retry-After header value on a 429

# # --- Leader election (P4.1) ---
# LEADER_ELIGIBLE=true        # compete for leadership / run the singleton loops
# LEADER_TTL_MS=10000         # leader lease TTL (renewed at TTL/3)

# # --- Cron (P4.4) ---
# CRON_TICK_MS=1000           # cron materializer scan cadence

# # --- HTTP server timeouts ---
# HTTP_READ_TIMEOUT_MS=10000
# HTTP_WRITE_TIMEOUT_MS=15000
# HTTP_IDLE_TIMEOUT_MS=60000
# HTTP_SHUTDOWN_TIMEOUT_MS=10000
